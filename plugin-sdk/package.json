{
  "name": "moons-plugin-sdk",
  "version": "1.5.0",
  "description": "SDK for building MooNs plugins: types, definePlugin, a mock host, manifest validation, and the create-moons-plugin / moons-plugin CLIs.",
  "type": "module",
  "license": "MIT",
  "author": "schowdary75",
  "maintainers": [
    {
      "name": "schowdary75",
      "url": "https://github.com/schowdary75"
    }
  ],
  "homepage": "https://github.com/schowdary75/MooNsPlanner/wiki/Plugin-Development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schowdary75/MooNsPlanner.git",
    "directory": "plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/schowdary75/MooNsPlanner/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/mock-host.d.ts",
        "default": "./dist/mock-host.js"
      },
      "require": {
        "types": "./dist/cjs/mock-host.d.ts",
        "default": "./dist/cjs/mock-host.js"
      }
    }
  },
  "bin": {
    "moons-plugin-sdk": "./dist/cli/moons-plugin.js",
    "moons-plugin": "./dist/cli/moons-plugin.js",
    "create-moons-plugin": "./dist/cli/create.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "semver": "^7.7.4",
    "update-notifier": "^7.3.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finish-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/semver": "^7.7.1",
    "@types/update-notifier": "^6.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "moons",
    "plugin",
    "sdk"
  ]
}
